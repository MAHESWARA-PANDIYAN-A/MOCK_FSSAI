# Mock FSSAI Backend Environment Configuration
PROJECT_NAME="Mock FSSAI / Food Safety Approval Portal"
ENV=development
PORT=8002

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:1234@localhost:5432/mock_fssai_db

# Security & JWT
JWT_SECRET=super-secret-fssai-mock-jwt-key-2026-sih
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Main SIH Portal Integration API Key (Used by Main SIH backend in X-API-Key header)
MOCK_FSSAI_API_KEY=fssai-mock-secret-key-2026

# Allowed Frontend & Main SIH Origins
FRONTEND_URL=http://localhost:5173
MAIN_SIH_PORTAL_URL=http://localhost:3000

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# Mock OTP for Development Verification
MOCK_OTP=123456

# Webhook Callback to Main SIH Portal (Optional)
SIH_WEBHOOK_URL=
